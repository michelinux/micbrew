#!/bin/bash
set -euo pipefail

brew_path=${MICBREW_REAL_BREW:-/usr/local/bin/brew}
repository=michelinux/micbrew
mode=${1:-}
case "$mode" in
  install|reinstall|update|upgrade) ;;
  *) exec "$brew_path" "$@" ;;
esac

if [[ "$(uname -m)" != x86_64 || "$(sw_vers -productVersion)" != 15.* ]]; then
  exec "$brew_path" "$@"
fi

shift
# Leave explicit options and paths to Homebrew, including --dry-run and --build-from-source.
for arg in "$@"; do
  case "$arg" in
    homebrew/core/*) ;;
    -*|*/*|*.rb) exec "$brew_path" "$mode" "$@" ;;
  esac
done
if [[ $# -eq 0 && "$mode" =~ ^(install|reinstall)$ || $# -gt 0 && "$mode" == update ]]; then
  exec "$brew_path" "$mode" "$@"
fi
project_dir="$(cd -- "$(dirname -- "$0")/.." && pwd)"
bottle_required() {
  local name=${1#homebrew/core/}
  [[ -n "$name" && "${MICBREW_BOTTLE_ONLY:-}" == "$name" ]] ||
    grep -Fxq -- "$name" "$project_dir/bottle-only.txt"
}

if ! command -v jq >/dev/null; then
  for arg in "$@"; do
    if bottle_required "$arg"; then
      printf 'micbrew: jq is required to look up the bottle for %s.\n' "$arg" >&2
      exit 1
    fi
  done
  if [[ "$mode" == upgrade && $# -eq 0 && ( -s "$project_dir/bottle-only.txt" || -n "${MICBREW_BOTTLE_ONLY:-}" ) ]]; then
    printf 'micbrew: jq is required to honor the bottle-only list during upgrades.\n' >&2
    exit 1
  fi
  exec "$brew_path" "$mode" "$@"
fi
# shellcheck source=lib/bottle.sh
source "$project_dir/lib/bottle.sh"

if [[ "$mode" == update ]]; then
  "$brew_path" update
elif [[ -z "${HOMEBREW_NO_AUTO_UPDATE:-}" ]]; then
  "$brew_path" update --auto-update
fi
export HOMEBREW_NO_AUTO_UPDATE=1

catalog="$(bottle_catalog "$repository")"

work_dir=
trap 'if [[ -n "$work_dir" ]]; then rm -rf -- "$work_dir"; fi' EXIT
if [[ "$mode" != update && "$catalog" != '[]' ]]; then
  work_dir="$(mktemp -d "${TMPDIR:-/tmp}/micbrew.XXXXXX")"
fi
unmanaged=()

process_formula() {
  local arg=$1 name=${1#homebrew/core/} metadata identity version artifact run_id bottle_path
  local bulk=${2:-} directory archive strict=false bottle_command="$mode"
  set --
  if [[ "$mode" != update ]] && bottle_required "$name"; then
    strict=true
    set -- --force-bottle
    # Keep the bottle-only transaction from rebuilding reverse dependencies.
    local -x HOMEBREW_NO_INSTALLED_DEPENDENTS_CHECK=1
  fi
  if ! metadata="$(formula_metadata "$arg")"; then
    if [[ "$strict" == true ]]; then
      printf 'micbrew: unable to resolve the formula for %s.\n' "$arg" >&2
      return 1
    fi
    unmanaged+=("$arg")
    return
  fi

  if ! jq -e --arg mode "$mode" '
    .formulae[0]
    | (.pinned | not)
      and (if $mode == "install" then
        (.installed | length == 0) or (.outdated and (env.HOMEBREW_NO_INSTALL_UPGRADE // "") == "")
      elif $mode == "reinstall" then (.installed | length > 0)
      else .outdated and (.installed | length > 0)
      end)
  ' <<< "$metadata" >/dev/null; then
    unmanaged+=("$arg")
    return
  fi

  identity="$(bottle_identity "$name" "$metadata")"
  IFS=$'\t' read -r version artifact <<< "$identity"
  run_id="$(artifact_run "$artifact")"

  if [[ "$mode" == update ]]; then
    if [[ -n "$run_id" ]]; then
      printf 'micbrew: %s %s has a matching Intel bottle.\n' "$name" "$version"
    fi
    return
  fi

  bottle_path="$(download_bottle "$name" "$version" "$artifact" "$run_id")"
  if [[ -n "$bottle_path" ]]; then
    directory="${bottle_path%/*}"
    archive="./${bottle_path##*/}"
    if [[ "$mode" == upgrade ]]; then
      # Homebrew accepts local bottles through install, which can upgrade an outdated keg.
      bottle_command=install
      local -x HOMEBREW_NO_INSTALL_UPGRADE=
      if ! jq -e '.formulae[0].installed | any(.installed_on_request == true)' <<< "$metadata" >/dev/null; then
        set -- "$@" --as-dependency
      fi
    fi
    prepare_dependencies "$bottle_command" "$directory" "$name" "$strict" "$@" "$archive"
    # Keep a bottle install from triggering source rebuilds of unrelated outdated dependents.
    HOMEBREW_NO_INSTALLED_DEPENDENTS_CHECK=1 run_brew "$directory" "$bottle_command" "$@" "$archive"
    return
  fi

  if [[ "$strict" == true ]]; then
    printf 'micbrew: waiting for a matching GitHub bottle for %s %s.\n' "$name" "$version" >&2
    return 1
  fi

  if [[ -z "$bulk" ]] && ! upstream_bottle_available "$metadata"; then
    prepare_dependencies "$mode" "" "$name" false --build-from-source "$arg"
    "$brew_path" "$mode" --build-from-source "$arg"
  else
    if [[ -z "$bulk" ]]; then
      prepare_dependencies "$mode" "" "$name" false "$arg"
    fi
    unmanaged+=("$arg")
  fi
}

if [[ $# -eq 0 ]]; then
  # With no arguments, look for bottles before Homebrew upgrades everything else.
  outdated="$("$brew_path" outdated --formula --json=v2 | jq -r '.formulae[] | select(.pinned | not) | .name')"
  while IFS= read -r name; do
    if [[ -n "$name" ]] && { { [[ "$mode" == upgrade ]] && bottle_required "$name"; } ||
      jq -e --arg prefix "$name-" 'any(.name | startswith($prefix))' <<< "$catalog" >/dev/null; }; then
      process_formula "$name" bulk
    fi
  done <<< "$outdated"
  if [[ "$mode" == upgrade ]]; then
    prepare_dependencies upgrade "" "" false
    "$brew_path" upgrade
  fi
else
  for arg in "$@"; do
    process_formula "$arg"
  done
  if [[ ${#unmanaged[@]} -gt 0 ]]; then
    "$brew_path" "$mode" "${unmanaged[@]}"
  fi
fi
