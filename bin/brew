#!/bin/bash
set -euo pipefail

brew_path=${MICBREW_REAL_BREW:-/usr/local/bin/brew}
repository=michelinux/micbrew
mode=${1:-}
case "$mode" in
  install|reinstall|update|upgrade) ;;
  *) exec "$brew_path" "$@" ;;
esac

if [[ "$(uname -m)" != x86_64 || "$(sw_vers -productVersion)" != 15.* ]]; then
  exec "$brew_path" "$@"
fi

shift
# Leave explicit options and paths to Homebrew, including --dry-run and --build-from-source.
for arg in "$@"; do
  case "$arg" in
    homebrew/core/*) ;;
    -*|*/*|*.rb) exec "$brew_path" "$mode" "$@" ;;
  esac
done
if [[ $# -eq 0 && "$mode" =~ ^(install|reinstall)$ || $# -gt 0 && "$mode" == update ]]; then
  exec "$brew_path" "$mode" "$@"
fi
project_dir="$(cd -- "$(dirname -- "$0")/.." && pwd)"
bottle_required() {
  local name=${1#homebrew/core/}
  [[ -n "$name" && "${MICBREW_BOTTLE_ONLY:-}" == "$name" ]] ||
    grep -Fxq -- "$name" "$project_dir/bottle-only.txt"
}

if ! command -v jq >/dev/null; then
  for arg in "$@"; do
    if bottle_required "$arg"; then
      printf 'micbrew: jq is required to look up the bottle for %s.\n' "$arg" >&2
      exit 1
    fi
  done
  if [[ "$mode" == upgrade && $# -eq 0 && ( -s "$project_dir/bottle-only.txt" || -n "${MICBREW_BOTTLE_ONLY:-}" ) ]]; then
    printf 'micbrew: jq is required to honor the bottle-only list during upgrades.\n' >&2
    exit 1
  fi
  exec "$brew_path" "$mode" "$@"
fi
# shellcheck source=lib/bottle.sh
source "$project_dir/lib/bottle.sh"

if [[ "$mode" == update ]]; then
  "$brew_path" update
elif [[ -z "${HOMEBREW_NO_AUTO_UPDATE:-}" ]]; then
  "$brew_path" update --auto-update
fi
export HOMEBREW_NO_AUTO_UPDATE=1

catalog='[]'
if command -v gh >/dev/null; then
  if ! catalog="$(gh api --method GET --paginate --slurp \
    "repos/$repository/actions/artifacts" -f per_page=100 |
    jq -c '[.[].artifacts[] | select(.expired == false and (.name | endswith("-sequoia-intel-bottle")))]')"; then
    printf 'micbrew: GitHub bottles are unavailable. Using Homebrew.\n' >&2
    catalog='[]'
  fi
fi

work_dir=
trap 'if [[ -n "$work_dir" ]]; then rm -rf -- "$work_dir"; fi' EXIT
if [[ "$mode" != update && "$catalog" != '[]' ]]; then
  work_dir="$(mktemp -d "${TMPDIR:-/tmp}/micbrew.XXXXXX")"
fi
unmanaged=()

formula_metadata() {
  local arg=$1 name=${1#homebrew/core/} metadata
  if [[ ! "$name" =~ ^[a-z0-9][a-z0-9+_.-]*(@[0-9][0-9.]*)?$ ]] ||
    ! metadata="$("$brew_path" info --formula --json=v2 "$arg" 2>/dev/null)" ||
    ! jq -e --arg name "$name" '.formulae[0] | .name == $name and .tap == "homebrew/core" and .versions.stable != null' \
      <<< "$metadata" >/dev/null; then
    return 1
  fi
  printf '%s\n' "$metadata"
}

artifact_run() {
  jq -r --arg name "$1" '
    map(select(.name == $name and .workflow_run.head_repository_id == .workflow_run.repository_id)
        | select(.workflow_run.id != null))
    | max_by(.created_at) | .workflow_run.id // empty
  ' <<< "$catalog"
}

upstream_bottle_available() {
  jq -e '
    .formulae[0].bottle.stable.files // {}
    | keys | any(test("^(all|sequoia|sonoma|ventura|monterey|big_sur|catalina|mojave|high_sierra|sierra|el_capitan|yosemite)$"))
  ' <<< "$1" >/dev/null
}

download_bottle() {
  local name=$1 version=$2 artifact=$3 run_id=$4 destination file digest
  [[ -n "$run_id" ]] || return 0

  destination="$(mktemp -d "$work_dir/$name.XXXXXX")" || return
  if ! gh run download "$run_id" --repo "$repository" --name "$artifact" --dir "$destination" >&2; then
    printf 'micbrew: download failed for %s. Using Homebrew.\n' "$artifact" >&2
    return 0
  fi

  file="$name--$version.sequoia.bottle.tar.gz"
  if ! digest="$(awk -v file="./$file" '$2 == file {print $1}' "$destination/SHA256SUMS")" ||
    [[ ! "$digest" =~ ^[a-f0-9]{64}$ ]] ||
    ! printf '%s  %s\n' "$digest" "$destination/$file" | shasum -a 256 -c --status; then
    printf 'micbrew: checksum verification failed for %s.\n' "$file" >&2
    return 1
  fi
  printf '%s\n' "$destination/$file"
}

run_brew() {
  local directory=$1
  shift
  if [[ -n "$directory" ]]; then
    (cd "$directory" && HOMEBREW_DEVELOPER=1 "$brew_path" "$@")
  else
    "$brew_path" "$@"
  fi
}

prepare_dependencies() {
  [[ "$catalog" != '[]' ]] || return 0
  local command=$1 directory=$2 ancestors=$3 strict=$4 plan dependencies name version
  shift 4
  # Reinstall has no dry-run, but the install planner can show just its dependencies.
  if [[ "$command" == reinstall ]]; then
    command=install
    set -- --only-dependencies "$@"
  fi
  if ! plan="$(HOMEBREW_NO_COLOR=1 run_brew "$directory" "$command" --dry-run --no-ask "$@" 2>&1)"; then
    if [[ "$strict" == true ]]; then
      printf 'micbrew: unable to verify the bottle-only dependency plan.\n%s\n' "$plan" >&2
      return 1
    fi
    return 0
  fi
  dependencies="$(awk '
    /^==>/ {
      in_dependencies = /^==> Would (install|upgrade) [0-9]+ dependenc(y|ies)( for [^:]+)?:$/
      next
    }
    in_dependencies && (NF == 2 || (NF == 4 && $3 == "->")) {
      entry = $1 " " $NF
      if (!seen[entry]++) print entry
    }
  ' <<< "$plan")"
  while read -r name version; do
    [[ -n "$name" ]] || continue
    install_dependency_bottle "$name" "$version" "$ancestors" "$strict"
  done <<< "$dependencies"

  if [[ "$strict" == true ]] &&
    grep -Eq '^==> Would (install|upgrade) [0-9]+ dependenc(y|ies)( for [^:]+)?:$' <<< "$plan"; then
    plan="$(HOMEBREW_NO_COLOR=1 run_brew "$directory" "$command" --dry-run --no-ask "$@")"
    if grep -Eq '^==> Would (install|upgrade) [0-9]+ dependenc(y|ies)( for [^:]+)?:$' <<< "$plan"; then
      printf 'micbrew: the following plan still requires dependencies. Waiting for matching bottles.\n%s\n' "$plan" >&2
      return 1
    fi
  fi
}

install_dependency_bottle() {
  local arg=$1 planned_version=$2 ancestors=$3 strict=$4 name=${1#homebrew/core/}
  local metadata identity version artifact run_id bottle_path directory= reference="$arg"
  [[ " $ancestors " != *" $name "* ]] || return 0
  if [[ "$strict" != true ]]; then
    jq -e --arg prefix "$name-" 'any(.name | startswith($prefix))' <<< "$catalog" >/dev/null || return 0
  fi
  metadata="$(formula_metadata "$arg")" || return 0
  identity="$(bottle_identity "$name" "$metadata")"
  IFS=$'\t' read -r version artifact <<< "$identity"
  [[ "$version" == "$planned_version" ]] || return 0
  jq -e --arg version "$version" '
    .formulae[0] | (.pinned | not) and (.installed | all(.version != $version))
  ' <<< "$metadata" >/dev/null || return 0

  run_id="$(artifact_run "$artifact")"
  bottle_path="$(download_bottle "$name" "$version" "$artifact" "$run_id")"
  if [[ -n "$bottle_path" ]]; then
    directory="${bottle_path%/*}"
    reference="./${bottle_path##*/}"
  elif [[ "$strict" != true ]] || ! upstream_bottle_available "$metadata"; then
    return 0
  fi
  # A bottle can need another bottle even when the parent plan lists installs before upgrades.
  local options=(--as-dependency)
  if [[ "$strict" == true ]]; then
    options+=(--force-bottle)
  fi
  prepare_dependencies install "$directory" "$ancestors $name" "$strict" "${options[@]}" "$reference"
  if [[ -n "$bottle_path" ]]; then
    printf 'micbrew: using a GitHub bottle for dependency %s %s.\n' "$name" "$version"
  fi
  run_brew "$directory" install "${options[@]}" "$reference"
}

process_formula() {
  local arg=$1 name=${1#homebrew/core/} metadata identity version artifact run_id bottle_path
  local bulk=${2:-} directory archive strict=false bottle_command="$mode"
  set --
  if [[ "$mode" != update ]] && bottle_required "$name"; then
    strict=true
    set -- --force-bottle
    # Keep the bottle-only transaction from rebuilding reverse dependencies.
    local -x HOMEBREW_NO_INSTALLED_DEPENDENTS_CHECK=1
  fi
  if ! metadata="$(formula_metadata "$arg")"; then
    if [[ "$strict" == true ]]; then
      printf 'micbrew: unable to resolve the formula for %s.\n' "$arg" >&2
      return 1
    fi
    unmanaged+=("$arg")
    return
  fi

  if ! jq -e --arg mode "$mode" '
    .formulae[0]
    | (.pinned | not)
      and (if $mode == "install" then
        (.installed | length == 0) or (.outdated and (env.HOMEBREW_NO_INSTALL_UPGRADE // "") == "")
      elif $mode == "reinstall" then (.installed | length > 0)
      else .outdated and (.installed | length > 0)
      end)
  ' <<< "$metadata" >/dev/null; then
    unmanaged+=("$arg")
    return
  fi

  identity="$(bottle_identity "$name" "$metadata")"
  IFS=$'\t' read -r version artifact <<< "$identity"
  run_id="$(artifact_run "$artifact")"

  if [[ "$mode" == update ]]; then
    if [[ -n "$run_id" ]]; then
      printf 'micbrew: %s %s has a matching Intel bottle.\n' "$name" "$version"
    fi
    return
  fi

  bottle_path="$(download_bottle "$name" "$version" "$artifact" "$run_id")"
  if [[ -n "$bottle_path" ]]; then
    directory="${bottle_path%/*}"
    archive="./${bottle_path##*/}"
    if [[ "$mode" == upgrade ]]; then
      # Homebrew accepts local bottles through install, which can upgrade an outdated keg.
      bottle_command=install
      local -x HOMEBREW_NO_INSTALL_UPGRADE=
      if ! jq -e '.formulae[0].installed | any(.installed_on_request == true)' <<< "$metadata" >/dev/null; then
        set -- "$@" --as-dependency
      fi
    fi
    prepare_dependencies "$bottle_command" "$directory" "$name" "$strict" "$@" "$archive"
    run_brew "$directory" "$bottle_command" "$@" "$archive"
    return
  fi

  if [[ "$strict" == true ]]; then
    printf 'micbrew: waiting for a matching GitHub bottle for %s %s.\n' "$name" "$version" >&2
    return 1
  fi

  if [[ -z "$bulk" ]] && ! upstream_bottle_available "$metadata"; then
    prepare_dependencies "$mode" "" "$name" false --build-from-source "$arg"
    "$brew_path" "$mode" --build-from-source "$arg"
  else
    if [[ -z "$bulk" ]]; then
      prepare_dependencies "$mode" "" "$name" false "$arg"
    fi
    unmanaged+=("$arg")
  fi
}

if [[ $# -eq 0 ]]; then
  # With no arguments, look for bottles before Homebrew upgrades everything else.
  outdated="$("$brew_path" outdated --formula --json=v2 | jq -r '.formulae[] | select(.pinned | not) | .name')"
  while IFS= read -r name; do
    if [[ -n "$name" ]] && { { [[ "$mode" == upgrade ]] && bottle_required "$name"; } ||
      jq -e --arg prefix "$name-" 'any(.name | startswith($prefix))' <<< "$catalog" >/dev/null; }; then
      process_formula "$name" bulk
    fi
  done <<< "$outdated"
  if [[ "$mode" == upgrade ]]; then
    prepare_dependencies upgrade "" "" false
    "$brew_path" upgrade
  fi
else
  for arg in "$@"; do
    process_formula "$arg"
  done
  if [[ ${#unmanaged[@]} -gt 0 ]]; then
    "$brew_path" "$mode" "${unmanaged[@]}"
  fi
fi
